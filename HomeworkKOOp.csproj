<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Индивидуальные проекты собираются отдельно и не должны попадать
       в компиляцию основного проекта. -->
  <ItemGroup>
    <Compile Remove="Индивидуальные/**/*.cs" />
    <Compile Remove="Индивидуальные/**/obj/**/*.cs" />
    <Compile Remove="Индивидуальные/**/bin/**/*.cs" />
  </ItemGroup>
</Project>
